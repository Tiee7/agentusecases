---
import Base from '../layouts/Base.astro';import Explorer from '../components/Explorer.astro';import {loadContent,categories} from '../lib/content.mjs';
const {catalog,reports}=loadContent();
---
<Base title="全部案例目录" active="catalog"><section class="wrap page-intro"><p class="eyebrow">THE INDEX · 案例索引</p><h1>一份不断展开的<br/>Agent 商业地图。</h1><p>共 {catalog.length.toLocaleString('en-US')} 个登记案例，{reports.length} 篇完成深研。<br/>按首次收录时间排列，待研究案例可直接查看来源。</p></section>
<section class="wrap archive" data-explorer="catalog" data-page-size="30"><Explorer mode="catalog" total={catalog.length}/><div class="catalog-head" aria-hidden="true"><span>案例 / 业务场景</span><span>研究状态</span><span>阅读入口</span></div><div data-list>{catalog.map((c,index)=><article class="catalog-row" data-item data-search={`${c.title} ${c.sourceCase.agentLabel} ${c.id} ${c.category} ${categories[c.category]||''}`} data-status={c.complete?'completed':'pending'}><div class="catalog-title"><span class="serial">{String(index+1).padStart(4,'0')}</span><div><h2>{c.complete?<a href={`/reports/${c.id}/`}>{c.title}</a>:c.title}</h2><span>{categories[c.category]||c.category||'未分类'} · 实际 agent：{c.sourceCase.agentLabel}{!c.listed?' · 历史收录':''}{c.firstSeen && ` · 收录于 ${c.firstSeen.slice(0,10)}`}</span></div></div><span class={`catalog-state ${c.complete?'complete':''}`}>{c.complete?'已完成深研':'待研究'}</span><a class="row-link" href={`/cases/${c.id}/`}>本站案例档案 ↗</a>{c.complete?<a class="row-link" href={`/reports/${c.id}/`}>阅读报告 ↗</a>:c.source?<a class="row-link" href={c.source} target="_blank" rel="noopener noreferrer">查看案例来源 ↗</a>:<span>暂无公开来源</span>}{c.sourceTrial.status==='available' && <a class="row-link" href={`/trials/${c.id}/`}>源站试用模板 ↗</a>}</article>)}</div><nav class="pagination" data-pagination hidden aria-label="目录分页"><button data-prev type="button">← 上一页</button><span data-page-label aria-live="polite"></span><button data-next type="button">下一页 →</button></nav></section></Base>
