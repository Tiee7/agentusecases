---
import Base from '../../layouts/Base.astro';
import SourceArchive from '../../components/SourceArchive.astro';
import {loadContent} from '../../lib/content.mjs';
export function getStaticPaths(){return loadContent().catalog.map(item=>({params:{id:item.id},props:{item}}))}
const {item}=Astro.props;const source=item.sourceTrial;
---
<Base title={`${item.title} · 案例档案`} active="catalog"><div class="wrap article-top case-top"><a href="/catalog/">← 返回案例目录</a><h1>{item.title}</h1><p>{item.complete?'已完成商业深研':'待研究'}</p>{item.complete && <a href={`/reports/${item.id}/`}>阅读商业分析与自编试用模板 →</a>}</div><article class="wrap prose case-reading"><SourceArchive archive={item.archive} trial={source}/><section id="source-trial"><h2>源站 Try it yourself / Copy prompt</h2><p>建议工具：{source.agent || '未收录'}</p>{source.status==='available'?<><p>将方括号内容替换为你的任务信息。</p><pre class="prompt-text" id="source-prompt" tabindex="0">{source.text}</pre><button type="button" id="copy-source" class="copy-prompt" hidden>复制源站模板 / Copy prompt</button><p id="copy-status" role="status" aria-live="polite"></p><noscript><p>可手动选择上方文本。</p></noscript></>:<p>模板未收录</p>}</section></article></Base>
<script>
const button=document.querySelector<HTMLButtonElement>('#copy-source');
if(button){button.hidden=false;button.addEventListener('click',async()=>{const prompt=document.querySelector<HTMLElement>('#source-prompt')!;const status=document.querySelector('#copy-status')!;try{await navigator.clipboard.writeText(prompt.textContent || '');status.textContent='已复制 / Copied'}catch{status.textContent='无法自动复制，请选择上方文本手动复制。';const range=document.createRange();range.selectNodeContents(prompt);const selection=getSelection();selection?.removeAllRanges();selection?.addRange(range);prompt.focus()}})}
</script>
