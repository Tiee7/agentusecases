---
import Base from '../layouts/Base.astro';
import ReportCard from '../components/ReportCard.astro';
import Explorer from '../components/Explorer.astro';
import { loadContent, decisions, dateLabel, tone } from '../lib/content.mjs';
const {reports,catalog}=loadContent();const featured=reports[0];
---
<Base active="reports">
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="red-dot"></span> INDEPENDENT RESEARCH · 商业案例笔记</p><h1>好故事之外，<br/>生意<span class="red">成立吗？</span></h1><p class="hero-description">从真实的 Agent 案例出发，拆解需求、收入与交付。<br class="desktop-break"/>让每一次投入，都有证据可循。</p><a class="ink-link" href="#research">翻阅研究档案 <span>↓</span></a></div><aside class="hero-note"><div class="note-top">THE RESEARCH LEDGER <span>研 / 读</span></div><div class="ledger-number">{String(reports.length).padStart(2,'0')}<span>篇商业深研</span></div><div class="ledger-bottom"><span>{catalog.length.toLocaleString('en-US')} 个案例，持续积累</span><span>证据先于结论</span></div><div class="stamp" aria-hidden="true">实证<br/>求真</div></aside></section>
{featured && <section class="featured wrap"><div class="feature-label"><span class="eyebrow">LATEST NOTE</span><span>最新研究</span><small>{dateLabel(featured.date)}</small></div><a class="featured-title" href={`/reports/${featured.id}/`}><span class={`badge ${tone(featured.verdict.decision)}`}>{featured.verdict.decision}</span><h2>{featured.title}</h2></a><div class="featured-end"><span>{featured.score}<small> /100</small></span><a href={`/reports/${featured.id}/`} aria-label={`阅读最新研究：${featured.title}`}>阅读全文 ↗</a></div></section>}
<section class="wrap research-section" id="research" data-explorer="reports"><div class="section-heading"><div><p class="eyebrow">THE COLLECTION</p><h2>已完成的深度研究<span class="count">{reports.length}</span></h2></div><a href="/catalog/">查看全部案例目录 ↗</a></div><Explorer total={reports.length} decisions={decisions}/><div class="report-grid" data-list>{reports.map((report,index)=><ReportCard report={report} index={index}/>)}</div></section>
<section class="method-strip wrap"><span class="eyebrow">READ WITH CONTEXT</span><h2>评分是判断的起点，<br/>证据才是阅读的重点。</h2><div><p>每份研究区分事实、自述与假设。<br/>没有验证的成功，不写成确定的收益。</p><a class="ink-link" href="/method/">了解研究方法 <span>↗</span></a></div></section>
</Base>
