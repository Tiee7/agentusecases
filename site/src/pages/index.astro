---
import Base from '../layouts/Base.astro';
import ReportCard from '../components/ReportCard.astro';
import Explorer from '../components/Explorer.astro';
import { loadContent, decisions, dateLabel, tone } from '../lib/content.mjs';
const {reports,briefs,catalog}=loadContent();const featured=reports[0];
---
<Base active="reports">
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="red-dot"></span> INDEPENDENT RESEARCH · 商业案例笔记</p><h1>拆解 AI 案例，<br/>分析<span class="red">商业价值。</span></h1><p class="hero-description">从真实的 Agent 案例出发，拆解需求、收入与交付。<br class="desktop-break"/>查找使用场景、试用模板与商业分析。</p><div class="collection-links"><a class="ink-link" href="/catalog/">全部收录 {catalog.length.toLocaleString('en-US')} <span>↗</span></a><a class="ink-link" href="#research">已完成深研 {reports.length} <span>↓</span></a><a class="ink-link" href="/briefs/" data-brief-count={briefs.length}>简报 {briefs.length} <span>↗</span></a></div></div><aside class="hero-note"><div class="note-top">THE RESEARCH LEDGER <span>研 / 读</span></div><div class="ledger-number">{String(reports.length).padStart(2,'0')}<span>篇商业深研</span></div><div class="ledger-bottom"><span>{catalog.length.toLocaleString('en-US')} 个案例，持续积累</span><span>{catalog.filter(c=>c.status==='pending').length} 个待研究</span></div><div class="stamp" aria-hidden="true">案例<br/>研读</div></aside></section>
{featured && <section class="featured wrap"><div class="feature-label"><span class="eyebrow">LATEST NOTE</span><span>最新研究</span><small>{dateLabel(featured.date)}</small></div><a class="featured-title" href={`/reports/${featured.id}/`}><span class={`badge ${tone(featured.verdict.decision)}`}>{featured.verdict.decision}</span><h2>{featured.title}</h2></a><div class="featured-end"><span>{featured.scoreAvailable?<>{featured.score}<small> /100</small></>:'未评定'}</span><a href={`/reports/${featured.id}/`} aria-label={`阅读最新研究：${featured.title}`}>阅读全文 ↗</a></div></section>}
<section class="wrap research-section" id="research" data-explorer="reports"><div class="section-heading"><div><p class="eyebrow">THE COLLECTION</p><h2>已完成的深度研究<span class="count">{reports.length}</span></h2></div><a href="/catalog/">查看全部案例目录 ↗</a></div><Explorer total={reports.length} decisions={decisions}/><div class="report-grid" data-list>{reports.map((report,index)=><ReportCard report={report} index={index}/>)}</div></section>
</Base>
