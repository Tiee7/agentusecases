---
import Refs from './Refs.astro';
const {models,brief=false}=Astro.props;
const money=n=>typeof n==='number'&&Number.isFinite(n)?new Intl.NumberFormat('zh-CN',{minimumFractionDigits:2,maximumFractionDigits:2}).format(n):'待核实';
---
<section id="models"><p class="eyebrow">THE ECONOMICS</p><h2>收入与成本：把假设摊开</h2><p class="notice">情景测算 · 假设与币种见各表</p>{models.map(m=>{const costs=[m.api,m.human,m.other,m.acquisition];const unknown=costs.some(n=>n===null);const variable=costs.reduce((sum,n)=>sum+(n??0),0);const contribution=m.price===null?null:m.price-variable;const monthly=contribution!==null&&m.volume!==null&&m.fixed!==null?contribution*m.volume-m.fixed:null;return <div class="economic-model"><h3>{m.scenario}</h3>{(m.unit||m.currency) && <p class="small-text">{[m.unit,m.currency].filter(Boolean).join(' · ')}</p>}<div class="table-scroll" tabindex="0" role="region" aria-label={`${m.scenario}成本明细`}><table><thead><tr><th scope="col">{brief?'报价 / 预算收益':'收入'}</th><th scope="col">模型 / API</th><th scope="col">人工</th><th scope="col">其他可变成本</th><th scope="col">获客摊销</th></tr></thead><tbody><tr><td>{money(m.price)}</td><td>{money(m.api)}</td><td>{money(m.human)}</td><td>{money(m.other)}</td><td>{money(m.acquisition)}</td></tr></tbody></table></div><dl class="economic-results"><div><dt>{unknown?'已列项单位贡献':'单位贡献'}</dt><dd>{money(contribution)}</dd></div>{m.volume!==null && <div><dt>月交付量</dt><dd>{m.volume}</dd></div>}{m.fixed!==null && <div><dt>月固定成本</dt><dd>{money(m.fixed)}</dd></div>}{monthly!==null && <div><dt>{unknown?'已列项月贡献':'月经营贡献'}</dt><dd class={monthly<0?'red':''}>{money(monthly)}</dd></div>}</dl>{unknown && <p class="small-text">贡献还需扣除未核实的可变成本。</p>}{brief && m.cashKnown!==null && <div class="cash-budget"><h4>四周现金预算</h4><dl class="economic-results"><div><dt>已列现金</dt><dd>{money(m.cashKnown)}</dd></div>{m.cashUpfront!==null && <div><dt>固定费用实际预付</dt><dd>{money(m.cashUpfront)}</dd></div>}{m.cashLimit!==null && <div><dt>预算上限</dt><dd>{money(m.cashLimit)}</dd></div>}{m.cashBuffer!==null && <div><dt>未列现金余量</dt><dd>{money(m.cashBuffer)}</dd></div>}</dl><p>{m.budgetStatus==='known_items_already_over_budget'?'已列项已超预算。':'是否在预算内，仍取决于全部遗漏现金费用。'}</p></div>}{m.assumptions && <p>{m.assumptions}</p>}<Refs ids={m.refs}/></div>})}</section>
