---
const {score}=Astro.props;
const available=typeof score==='number' && Number.isFinite(score) && score>=0 && score<=100;
---
<a class="report-score" href="#score" aria-label={available?`商业评分 ${score} 分，满分 100；查看评分依据`:'商业评分待补充；查看评分依据'}>
 <span class="report-score-label">商业评分</span>
 <span class:list={['report-score-value',{'report-score-missing':!available}]}>{available?<>{score}<small>/100</small></>:'待评分'}</span>
 <span class="report-score-link">查看评分依据 ↓</span>
</a>
