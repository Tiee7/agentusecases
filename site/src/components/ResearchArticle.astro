---
import SourceArchive from './SourceArchive.astro';
import CommercialScore from './CommercialScore.astro';
import Economics from './Economics.astro';
import Base from '../layouts/Base.astro';import Refs from './Refs.astro';
import {dateLabel,tone,sourceStatusLabels} from '../lib/content.mjs';
const {report:r}=Astro.props;
const brief=r.depth==='brief';
const method=brief && r.reportedMethod?{...r.reportedMethod,status:'reported_summary'}:r.authorMethod;
const back=brief?'/briefs/':'/#research';
const methodHeading=r.reportedMethod?'归档转述的方法与来源':'外部原作者的方法与来源';
const toc=[{id:'source-case',title:'案例档案'},{id:'author-method',title:methodHeading},{id:'verdict',title:'商业判断'},{id:'personal',title:'自用价值'},{id:'try-it',title:'Copy prompt · 动手试用'},{id:'facts',title:brief?'事实与证据边界':'已核验事实'},...r.sections,{id:'models',title:'收入与成本测算'},{id:'score',title:'评分依据'},{id:'limits',title:'不同意见与未核实的问题'},{id:'next',title:'下一步与何时停止'},...(brief && (r.feedback.note || r.feedback.searches.length || r.feedback.observations.length)?[{id:'feedback',title:'用户反馈检索'}]:[]),{id:'sources',title:'来源与证据'}].filter(s=>s.id!=='next'||r.verdict.next||r.verdict.stop).filter(s=>s.id!=='limits'||r.counter||r.limitations);
---
<Base title={r.title} description={r.verdict.headline} active={brief?'briefs':'reports'}><div class="reading-progress" aria-hidden="true"><span id="reading-progress"></span></div><div class="wrap article-top"><a class="back-link" href={back}>← 返回{brief?'简报列表':'研究档案'}</a><div class="report-title-row"><div class="article-meta"><span>{brief?'简报':'案例研读'}</span>{r.date && <span>{dateLabel(r.date)}</span>}<span>约 {r.minutes} 分钟阅读</span></div><h1>{r.title}</h1>{!brief && <CommercialScore score={r.scoreAvailable?r.score:null}/>}</div><div class="article-byline">{r.industry && <span>{r.industry}</span>}<button id="print" class="text-button" type="button">打印 / 保存 PDF ↗</button></div>{brief && r.briefReason && <details class="brief-scope"><summary>本篇材料范围</summary><p>{r.briefReason}</p></details>}</div>
<div class="wrap reading-layout"><aside class="toc"><details open><summary>本篇目录 <span>↓</span></summary><nav aria-label="文章目录">{toc.map((s,i)=><a href={`#${s.id}`}><small>{String(i+1).padStart(2,'0')}</small>{s.title}</a>)}</nav></details></aside><article class="prose">
<SourceArchive archive={r.archive} trial={r.sourceTrial} inline={true}/>
<section id="author-method"><p class="eyebrow">THE ORIGINAL CASE</p><h2>{methodHeading}</h2><p>{method.source?<a href={method.source} target="_blank" rel="noopener noreferrer">{method.title} ↗</a>:<span>原始来源待补充</span>}</p>{method.status==='unavailable'?<p class="notice">方法摘要未收录</p>:<><p class="method-source-label">{r.reportedMethod?'归档转述的方法摘要':method.status==='author_summary'?'作者方法摘要':'报道摘要'}</p><div class="method-translation"><div lang="zh-CN"><h3>中文方法摘要</h3><ol>{method.steps.map(s=><li>{s.zh}</li>)}</ol></div><details><summary lang="en">English · Method summary</summary><ol lang="en">{method.steps.map(s=><li>{s.en}</li>)}</ol></details></div></>}</section>
{r.reportedMethod && r.authorMethod.source && <p class="small-text">外部原帖：<a href={r.authorMethod.source} target="_blank" rel="noopener noreferrer">{r.authorMethod.title} ↗</a> · 方法摘要未收录</p>}
<section id="verdict" class="verdict-box"><p class="eyebrow">THE VERDICT</p><h2>我们的分析</h2><p class={`badge ${tone(r.verdict.decision)}`}>{r.verdict.decision}</p>{!brief && <h3>{r.title}</h3>}<p>{r.verdict.headline}</p><p>{r.verdict.reason}</p></section>
<section id="personal"><p class="eyebrow">PERSONAL USE</p><h2>自用价值 · {r.personal.level}</h2><p>{r.personal.reason}</p><Refs ids={r.personal.refs}/><dl class="personal-details">{r.personal.details.map(d=><div><dt>{d.label}</dt><dd>{d.body}</dd></div>)}</dl></section>
<section id="try-it"><p class="eyebrow">TRY IT YOURSELF</p><h2>Copy prompt · 动手试用</h2>{r.sourceTrial.status!=='available' && <p data-source-trial-status={r.sourceTrial.status}>{sourceStatusLabels[r.sourceTrial.status]}</p>}{r.trial.prerequisites && <><h3>准备条件</h3><p>{r.trial.prerequisites}</p></>}{r.trial.tools && <><h3>工具</h3><p>{r.trial.tools}</p></>}{r.trial.expected && <><h3>预期结果</h3><p>{r.trial.expected}</p></>}{r.trial.prompts.map((p,i)=><div class="prompt-card"><h3>{p.title}</h3><p><strong>{p.kind==='site_template'?'源站试用模板':p.kind==='ours'?'自编模板':p.kind==='adapted'?'改写':'原文'}</strong> · {p.language}</p>{p.agent && <p>建议运行工具：{p.agent}</p>}<p>出处：{p.url?<a href={p.url} target="_blank" rel="noopener noreferrer">提示词来源 ↗</a>:p.kind==='ours'?'研究团队自编':'未收录'}</p><p class="small-text">{p.attribution}</p><Refs ids={p.refs}/><pre class="prompt-text" id={`prompt-${i}`} tabindex="0">{p.text}</pre><button type="button" class="copy-prompt" data-copy={`prompt-${i}`} hidden>复制提示词 / Copy prompt</button><p class="copy-status" role="status" aria-live="polite"></p></div>)}<noscript><p>可选择上方文本手动复制。</p></noscript></section>
<section id="facts"><p class="eyebrow">EVIDENCE FIRST</p><h2>{brief?'事实与证据边界':'已核验事实'}</h2><ol class="facts">{r.facts.map(f=><li>{brief && <small>{f.type}</small>}<p>{f.statement}</p><Refs ids={f.refs}/></li>)}</ol></section>
{r.sections.map((s,index)=><section id={s.id}><div class="chapter-number">{String(index+1).padStart(2,'0')}</div><h2>{s.title}</h2><p class="body-text">{s.body}</p><Refs ids={s.refs}/></section>)}
<Economics models={r.models} brief={brief}/>
<section id="score"><p class="eyebrow">COMMERCIAL PRIORITY</p>{brief?<><h2>价值评分</h2><p>简报不设总分。</p>{r.scoreTracks.map(track=><div class="score-breakdown"><h3>{track.title}</h3>{track.dimensions.map(d=><div><div class="score-row"><h3>{d.label}</h3><strong>{d.value===null?'待核实':`${d.value} / 4`}</strong></div>{d.rationale && <p>{d.rationale} <Refs ids={d.refs}/></p>}</div>)}</div>)}</>:r.scoreAvailable?<><h2>商业评分 <span class="red">{r.score}</span><small> / 100</small></h2><p>商业投入优先顺序 · 七项加权评分</p><div class="score-breakdown">{r.scores.map(s=><div><div class="score-row"><h3>{s.label}<small>权重 {s.weight}%</small></h3><strong>{s.value}<small> / 5</small></strong></div><div class="meter" aria-hidden="true"><span style={`width:${s.value/5*100}%`}></span></div><p>{s.rationale} <Refs ids={s.refs}/></p></div>)}</div></>:<><h2>商业评分 · 待补充</h2><p>评分资料不完整，暂不展示总分。</p></>}</section>
{(r.counter || r.limitations) && <section id="limits"><p class="eyebrow">WHAT WE DON'T KNOW</p><h2>不同意见与未核实的问题</h2><>{r.counter && <><h3>什么证据反驳了初始判断？</h3><p>{r.counter}</p></>}{r.limitations && <><h3>哪些仍未核实？</h3><p>{r.limitations}</p></>}</></section>}
{(r.verdict.next || r.verdict.stop) && <section id="next"><p class="eyebrow">NEXT DECISION</p><h2>下一步与何时停止</h2>{r.verdict.next && <><h3>下一步</h3><p>{r.verdict.next}</p></>}{r.verdict.stop && <div class="stop-box"><h3>何时停止投入</h3><p>{r.verdict.stop}</p></div>}</section>}
{brief && (r.feedback.note || r.feedback.searches.length || r.feedback.observations.length) && <section id="feedback"><h2>用户反馈检索</h2>{r.feedback.note && <p>{r.feedback.note}</p>}{r.feedback.observations.map(o=><p>{o.finding} <Refs ids={o.refs}/></p>)}{r.feedback.searches.length>0 && <details><summary>查看检索记录</summary><dl>{r.feedback.searches.map(q=><div><dt>{q.channel} · {q.query}</dt><dd>{q.outcome}</dd></div>)}</dl></details>}</section>}
<section id="sources"><p class="eyebrow">SOURCE NOTES</p><h2>来源与证据<span class="count">{r.sources.length}</span></h2><ol class="sources">{r.sources.map((s,index)=><li id={`source-${s.id}`}><span class="source-number">{String(index+1).padStart(2,'0')} · {s.id}</span><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a><p>{s.supports}</p>{brief && <p class="small-text">{s.status}</p>}<small>{new URL(s.url).hostname}</small></li>)}</ol></section>
<div class="article-end"><span>— 本篇完 —</span><a href={back}>继续阅读{brief?'其他简报':'其他案例'} →</a></div></article></div></Base>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>{
  button.hidden=false;
  button.addEventListener('click',async()=>{
   const prompt=document.getElementById(button.dataset.copy!);
   const status=button.parentElement!.querySelector('.copy-status')!;
   try { await navigator.clipboard.writeText(prompt?.textContent || ''); status.textContent='已复制 / Copied'; }
   catch { status.textContent='无法自动复制，请选择上方文本手动复制。'; if(prompt){ const range=document.createRange();range.selectNodeContents(prompt);const selection=window.getSelection();selection?.removeAllRanges();selection?.addRange(range);prompt.focus(); } }
  });
 });
 document.querySelector('#print')?.addEventListener('click',()=>window.print());
 const progress=document.querySelector<HTMLElement>('#reading-progress');
 const update=()=>{if(progress){const available=document.documentElement.scrollHeight-innerHeight;progress.style.width=`${available>0?scrollY/available*100:0}%`}};
 addEventListener('scroll',update,{passive:true});update();
 const details=document.querySelector<HTMLDetailsElement>('.toc details');if(details && matchMedia('(max-width: 1000px)').matches)details.open=false;
 const links=[...document.querySelectorAll<HTMLAnchorElement>('.toc nav a')];
 const observer=new IntersectionObserver(entries=>{for(const e of entries){if(e.isIntersecting){links.forEach(a=>{if(a.hash===`#${e.target.id}`)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current')})}}},{rootMargin:'-12% 0px -65% 0px'});
 document.querySelectorAll('.prose section[id]').forEach(s=>observer.observe(s));
</script>
