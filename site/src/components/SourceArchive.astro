---
const {archive:a,trial,inline=false}=Astro.props;
---
<section id="source-case"><p class="eyebrow">CASE ARCHIVE</p><h2>案例档案</h2>
<p class="case-tools">原始agent：{a.agents.join(' · ') || '未收录'}{trial?.agent && ` · 推荐工具：${trial.agent}`}</p>
{a.sourceText ? <details class="source-original source-pane" open={!a.translationText}><summary>English</summary><pre id="source-original" lang="en" class="archive-body">{a.sourceText}</pre></details>:null}
{a.translationText && <details class="source-translation source-pane" open><summary>中文</summary><pre id="source-translation" lang="zh-CN" class="archive-body">{a.translationText}</pre></details>}
<dl class="personal-details">{a.category && <div><dt>分类</dt><dd>{a.category}</dd></div>}<div><dt>标签</dt><dd>{a.tags.join(' · ') || '暂无标签'}</dd></div>{a.author && <div><dt>作者</dt><dd>{a.author}</dd></div>}{a.wanted!==null && <div><dt>Wanted</dt><dd>{a.wanted}</dd></div>}{a.sourceDate && <div><dt>发布日期</dt><dd>{a.sourceDate}</dd></div>}{a.addedAt && <div><dt>收录日期</dt><dd>{a.addedAt}</dd></div>}</dl>
<p><a href={a.url} target="_blank" rel="noopener noreferrer">来源页面 ↗</a></p>{a.originals.length>0 && <p>相关来源：{a.originals.map(u=><a href={u} target="_blank" rel="noopener noreferrer">{new URL(u).hostname} ↗ </a>)}</p>}
{inline && <p><a href={a.path}>查看案例与试用模板 →</a></p>}
</section>
<style>.archive-body{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;line-height:1.9;margin:0;padding:1rem 0;background:transparent;max-width:100%}.source-pane{border-top:1px solid var(--line,#ddd);padding:.9rem 0}.source-pane summary{cursor:pointer;font-size:1rem;font-weight:600;line-height:1.6}.source-pane summary:focus-visible{outline:2px solid var(--red);outline-offset:5px}.case-tools{font-size:.85rem;color:var(--muted);line-height:1.8}.personal-details dd{overflow-wrap:anywhere}.editorial-summary{margin-top:2rem}.editorial-summary h4{font-size:1rem;margin:1.25rem 0 .5rem}.editorial-summary ul{padding-left:1.25rem}</style>
