---
import '../styles/global.css';
const { title = '商业案例研究', description = '从真实业务出发，研究 AI Agent 的客户、收入、交付与边界。', active = '' } = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f4f1e9"/><title>{title} · Agent 研读</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body>
<a class="skip" href="#main">跳到正文</a>
<header class="site-header"><div class="header-inner"><a class="brand" href="/" aria-label="Agent 研读首页"><span class="brand-mark" aria-hidden="true">研</span><span>Agent <b>研读</b><small>BUSINESS CASE NOTES</small></span></a><nav aria-label="主导航"><a href="/" aria-current={active==='reports'?'page':undefined}>深度研究</a><a href="/catalog/" aria-current={active==='catalog'?'page':undefined}>案例目录</a><a href="/method/" aria-current={active==='method'?'page':undefined}>研究方法</a></nav></div></header>
<main id="main"><slot/></main>
<footer class="site-footer"><div><a class="footer-brand" href="/">Agent 研读<span>从故事，走向判断。</span></a><p>关注客户、成本与可复制性。<br/>事实有出处，判断有边界。</p></div><div class="footer-links"><a href="/method/">如何阅读这些研究 ↗</a><a href="https://github.com/Tiee7/agentusecases" target="_blank" rel="noopener noreferrer">开放研究仓库 ↗</a><span>由 Tiee 整理 · 只读研究档案</span></div></footer>
</body></html>
